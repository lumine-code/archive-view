{
  "name": "archive-view",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Browse the files and folders inside archive files.",
  "keywords": [
    "zip",
    "tar",
    "jar",
    "epub",
    "extract",
    "compressed"
  ],
  "repository": "https://github.com/lumine-code/archive-view",
  "bugs": {
    "url": "https://github.com/lumine-code/archive-view/issues"
  },
  "license": "MIT",
  "main": "./lib/archive-editor",
  "files": [
    "keymaps",
    "lib",
    "resources",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "ArchiveEditor": "deserialize",
    "ArchiveEditorView": "deserialize"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^2.0.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#c4f4a97341a0a99a0649135be00df09c887e7804",
    "@lumine-code/ls-archive": "github:lumine-code/ls-archive#127540d3cf689bfe15695483d0f6b1bc6527dd0c",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#49c48134ee6e25f8fa2391b41d2151c8f24e3ca2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
